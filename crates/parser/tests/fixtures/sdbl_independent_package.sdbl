// Остатки товаров с ценами: пакет из трёх запросов.
ВЫБРАТЬ
	Остатки.Номенклатура КАК Номенклатура,
	Остатки.КоличествоОстаток КАК Количество
ПОМЕСТИТЬ ВремОстатки
ИЗ
	РегистрНакопления.ТоварыНаСкладах.ОстаткиИОбороты(, , &Конец, , Склад В
		(ВЫБРАТЬ
			Склады.Ссылка
		ИЗ
			Справочник.Склады КАК Склады
		ГДЕ
			Склады.Активен)) КАК Остатки

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	Резерв.Номенклатура,
	-Резерв.Количество
ИЗ
	РегистрНакопления.Резервы КАК Резерв
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВремОстатки.Номенклатура КАК Номенклатура,
	СУММА(ВремОстатки.Количество) КАК Количество,
	ЕСТЬNULL(Цены.Цена, 0) КАК Цена
ИЗ
	ВремОстатки КАК ВремОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.Цены.СрезПоследних(&Конец, ) КАК Цены
		ПО ВремОстатки.Номенклатура = Цены.Номенклатура
СГРУППИРОВАТЬ ПО
	ВремОстатки.Номенклатура,
	ЕСТЬNULL(Цены.Цена, 0)
;

УНИЧТОЖИТЬ ВремОстатки
