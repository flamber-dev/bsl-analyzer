# The platform help corpus left the tree (#312); its 25 MB deletion is shown as
# one line rather than as text.
crates/bsl-platform/data/platform_data.json -diff
# The built-in interface facts are regenerated as a whole by
# scripts/strip-help-corpus-texts.py; an 11 MB line-by-line diff says nothing.
crates/bsl-platform/data/platform_facts.json -diff
# Preserve byte-for-byte Designer XML exports, including CRLF, across checkouts.
crates/bsl-metadata/fixtures/extension_common_attributes/**/*.xml -text whitespace=trailing-space,space-before-tab,cr-at-eol
# Expected analyze output pins line and column numbers of these sources; keep their
# bytes identical on every checkout.
crates/bsl-analyzer/tests/fixtures/foreign_handler_bindings/** -text
# Tests pin byte offsets and LF-only needles against these sources; a CRLF checkout
# (core.autocrlf=true) would fail them without any change in the code.
crates/ide-diagnostics/src/handlers/fixtures/** -text
crates/lexer/tests/fixtures/sdbl_golden_corpus.txt -text
# Read by tests that look for an LF-spelled needle (`"\n## "`, `"\n      - name:"`), so a CRLF
# checkout fails four tests with no change in the code. Spelled `eol=lf` rather than `-text`
# because, unlike the fixtures above, these are documents people edit: the checkout stays LF and
# an edit made on Windows cannot commit CRLF back into them.
docs/mcp/LOCATION_CONTRACT.md eol=lf
docs/mcp/TOOLS_AND_EXTENSION.md eol=lf
.github/workflows/ci.yml eol=lf
# The tests pin line and column of a finding inside a multi-line query string and compare the
# query text byte for byte with the module that holds it; a CRLF checkout would shift both.
crates/ide-diagnostics/tests/fixtures/derived_table_outer_alias/** -text
# The CFG contract compares an expect dump that pins byte offsets of these sources, and every
# parser fixture is compared byte for byte: the licence header of the module corpus, the CST
# dump and the recorded trivia ranges. A CRLF checkout shifts every offset by one per line.
crates/hir/tests/fixtures/cfg_contract/** -text
crates/parser/tests/fixtures/** -text
